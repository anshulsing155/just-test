generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// AUTH
// ═══════════════════════════════════════════════════════════════════

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  mobile      String    @unique
  name        String?
  email       String?
  role        String    @default("user") // user | admin
  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  otps         OtpVerification[]
  chatSessions ChatSession[]

  @@map("users")
}

model OtpVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  mobile    String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @db.ObjectId

  @@index([mobile, otp])
  @@map("otp_verifications")
}

// ═══════════════════════════════════════════════════════════════════
// CORE: PROJECT (central entity — everything connects here)
// ═══════════════════════════════════════════════════════════════════

model Project {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  state                String   // UP, Delhi, MP, Punjab, Rajasthan
  reraRegNo            String   // RERA registration number (e.g. UPRERAPRJ17620)
  name                 String
  district             String?
  projectType          String?  // Residential, Commercial, Mixed, Plotted
  location             String?
  constructionStatus   String?  // Ongoing, Completed, Not Started
  validUntil           String?
  certificateUrl       String?
  extensionCertificate String?

  // Rich detail (populated on detail-page scrape)
  projectInfo     Json? // { key: value } pairs
  locationInfo    Json?
  financialInfo   Json?
  propertyDetails Json? // table rows (apartments, plots, etc.)
  sections        Json? // extra named sections

  // Metadata
  rawData   Json?
  scrapedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relationships ──
  companyLinks ProjectCompany[]
  agentLinks   ProjectAgent[]
  bankTieups   ProjectBank[]

  @@unique([state, reraRegNo])
  @@index([state])
  @@index([district])
  @@index([state, district])
  @@map("projects")
}

// ═══════════════════════════════════════════════════════════════════
// COMPANY (unified: developer / builder / promoter / contractor)
//
// WHY one table?  In real estate the SAME legal entity often acts as
// promoter on one project and builder on another.  RERA registers
// the entity once — the *role* is per-project.
// ═══════════════════════════════════════════════════════════════════

model Company {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  state           String
  reraRegNo       String?  // RERA promoter/builder reg no (e.g. UPRERAPRM10171)
  name            String
  legalType       String?  // Company, Individual, Partnership, Society, LLP, Trust
  address         String?
  mobile          String?
  email           String?
  district        String?
  pan             String?
  gstin           String?
  website         String?
  contactPerson   String?  // chairman / director / authorized signatory

  // Metadata
  rawData   Json?
  scrapedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relationships ──
  projectLinks ProjectCompany[]

  @@unique([state, name])
  @@index([state])
  @@index([name])
  @@index([reraRegNo])
  @@map("companies")
}

// ═══════════════════════════════════════════════════════════════════
// AGENT (RERA-registered real-estate agents / brokers)
// ═══════════════════════════════════════════════════════════════════

model Agent {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  state            String
  reraRegNo        String   // RERA agent reg no (e.g. DLRERA2025A0022)
  name             String
  district         String?
  address          String?
  mobile           String?
  email            String?
  firmType         String?  // Individual, Company, Partnership
  fatherName       String?
  tehsil           String?
  panNumber        String?
  aadharNumber     String?
  registrationDate String?
  validUpto        String?
  status           String?  // Approved, Pending, Expired
  certificateUrl   String?

  // Payment / bank detail (from detail page)
  registrationFee String?
  paymentDate     String?
  transactionId   String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  branchName      String?
  bankAddress     String?

  // Partners (for company/partnership agents)
  partners    Json? // [{ name, email, mobile, image }]
  detailsLink String?

  // Metadata
  rawData   Json?
  scrapedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relationships ──
  projectLinks ProjectAgent[]

  @@unique([state, reraRegNo])
  @@index([state])
  @@index([name])
  @@map("agents")
}

// ═══════════════════════════════════════════════════════════════════
// JUNCTION: Project ↔ Company  (with ROLE)
//
// This is the KEY table.  One project can have:
//   • 1 promoter (usually the landowner / RERA applicant)
//   • 1+ builders (construction companies)
//   • 1 developer (the brand)
//   • 1+ contractors
// And the same company can play DIFFERENT roles on different projects.
// ═══════════════════════════════════════════════════════════════════

model ProjectCompany {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  role      String // developer | builder | promoter | contractor | joint_promoter
  isPrimary Boolean @default(false) // primary company for this role

  // Optional metadata
  sharePercentage Float?   // for JV projects
  startDate       String?
  endDate         String?

  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@unique([projectId, companyId, role])
  @@index([projectId])
  @@index([companyId])
  @@index([role])
  @@map("project_companies")
}

// ═══════════════════════════════════════════════════════════════════
// JUNCTION: Project ↔ Agent
//
// Many-to-many: one agent sells multiple projects,
//               one project has multiple selling agents.
// ═══════════════════════════════════════════════════════════════════

model ProjectAgent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Optional metadata
  commissionPct Float?  // agent commission %
  startDate     String?
  endDate       String?

  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @db.ObjectId

  agent   Agent  @relation(fields: [agentId], references: [id])
  agentId String @db.ObjectId

  @@unique([projectId, agentId])
  @@index([projectId])
  @@index([agentId])
  @@map("project_agents")
}

// ═══════════════════════════════════════════════════════════════════
// JUNCTION: Project ↔ Bank (for DSA / Loan tieup)
// ═══════════════════════════════════════════════════════════════════

model ProjectBank {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  bankName     String
  loanAvailable Boolean @default(true)
  interestRate  Float?
  maxLoanPct    Float?  // max LTV %
  processingFee String?
  remarks       String?

  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @db.ObjectId

  @@unique([projectId, bankName])
  @@index([projectId])
  @@map("project_banks")
}

// ═══════════════════════════════════════════════════════════════════
// CHAT / ASSISTANT
// ═══════════════════════════════════════════════════════════════════

model ChatSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?   @relation(fields: [userId], references: [id])
  userId   String? @db.ObjectId
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  role      String   // system, user, assistant
  content   String
  createdAt DateTime @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String      @db.ObjectId

  @@index([sessionId])
  @@map("chat_messages")
}

// ═══════════════════════════════════════════════════════════════════
// SCRAPE TRACKING
// ═══════════════════════════════════════════════════════════════════

model ScrapeLog {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  source     String
  state      String
  status     String    // running | success | failed
  totalItems Int       @default(0)
  duration   Int?      // ms
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([source, state])
  @@map("scrape_logs")
}
